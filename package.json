{
  "publisher": "LilyOliveira",
  "name": "catppuccin-palette-picker",
  "displayName": "Catppuccin Palette Picker",
  "version": "1.0.1",
  "description": "Easily reference and copy Catppuccin Palette color codes directly inside VS Code.",
  "author": "Lily Oliveira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lily-gh/catppuccin-palette-picker"
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.102.0"
  },
  "keywords": [
    "catppuccin",
    "color picker",
    "palette",
    "colors",
    "color-picker",
    "pastel-colors"
  ],
  "categories": [
    "Other"
  ],
  "sponsor": {
    "url": "https://ko-fi.com/lily_neinhorn"
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "catppuccinPaletteSidebar-view",
          "title": "Catppuccin Palette Picker",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "catppuccinPaletteSidebar-view": [
        {
          "type": "webview",
          "id": "catppuccinPaletteSidebar",
          "name": "Catppuccin Palette Picker",
          "icon": "media/icon.png",
          "contextualTitle": "Catppuccin Palette Picker 🎨"
        }
      ]
    },
    "commands": [
      {
        "command": "catppuccinPalette.activateCatppuccinPalettePicker",
        "title": "Catppuccin Palette Picker"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "cd webview-ui && npm run build && cd .."
  },
  "devDependencies": {
    "@types/vscode": "^1.102.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
