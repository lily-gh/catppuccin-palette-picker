{
  "name": "catppuccin-palette",
  "displayName": "Catppuccin Palette Picker",
  "description": "Easily copy Catppuccin Palette color codes to style other tools and apps using VS Code.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:catppuccinPaletteSidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "catppuccinPaletteSidebar-view",
          "title": "Catppuccin Palette Picker",
          "icon": "media/icon3.png"
        }
      ]
    },
    "views": {
      "catppuccinPaletteSidebar-view": [
        {
          "type": "webview",
          "id": "catppuccinPaletteSidebar",
          "name": "Catppuccin Palette Picker",
          "icon": "media/icon3.png",
          "contextualTitle": "Catppuccin Palette Picker 🎨"
        }
      ]
    },
    "commands": [
      {
        "command": "catppuccinPalette.activateCatppuccinPalettePicker",
        "title": "Catppuccin Palette Picker"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "cd webview-ui && npm run build && cd .."
  },
  "devDependencies": {
    "@types/vscode": "^1.102.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
